#!/usr/bin/env bash
# Stable entrypoint for the treehouse engine.
set -euo pipefail

# Follow symlinks to the real file before deriving the repo path: the README's
# ~/.local/bin symlink used to resolve to ~/.local/src/main.ts and fail.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$LINK_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec bun run "$SCRIPT_DIR/../src/main.ts" "$@"
